# ==============================================================================
# NeuroCare Supabase Backend Configuration (.env.local)
# Copy this file to .env.local and provide your Supabase project URL and
# client-safe publishable/anon key (NEVER put a service_role/secret key here).
# ==============================================================================
# VITE_SUPABASE_PROJECT_ID=your_supabase_project_ref
# VITE_SUPABASE_URL=https://your_project_ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ==============================================================================
# NeuroCare Real SMS OTP Gateway Configuration (.env.local)
# Copy this file to .env.local and fill in ONE SMS provider below to send live
# SMS OTP messages directly to mobile numbers during registration.
# Without an SMS API key configured, /api/otp/send safely uses local preview mode.
# ==============================================================================

# --- Option 1: Fast2SMS (Recommended for India +91) ---
# FAST2SMS_API_KEY=your_fast2sms_api_key
# FAST2SMS_ROUTE=q
# FAST2SMS_SENDER_ID=

# --- Option 2: Twilio Programmable SMS (Global E.164: +91, +971, +1, +44, +65) ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+15551234567
# TWILIO_MESSAGING_SERVICE_SID=

# --- Option 3: MSG91 (India / Global DLT OTP Template) ---
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_TEMPLATE_ID=your_msg91_dlt_template_id

# --- Option 4: Custom SMS Webhook Relay (receives POST JSON { phone, otp, message }) ---
# OTP_SMS_WEBHOOK_URL=https://your-sms-relay.example.com/send-otp
# OTP_SMS_WEBHOOK_SECRET=

